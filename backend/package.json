{
    "name": "langsphere-backend",
    "version": "2.0.0",
    "description": "Enterprise Backend API for LangSphere AI - Indian Language Learning Platform",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --testTimeout=30000 --forceExit",
        "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --runInBand --testTimeout=30000 --forceExit",
        "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch --testTimeout=30000",
        "lint": "eslint . --ext .js --ignore-pattern node_modules/",
        "lint:fix": "eslint . --ext .js --fix --ignore-pattern node_modules/"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.6.0",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.0",
        "morgan": "^1.11.0",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "sharp": "^0.34.5",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "tesseract.js": "^5.0.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.0.1",
        "supertest": "^7.2.2"
    },
    "jest": {
        "testEnvironment": "node",
        "transform": {},
        "testMatch": [
            "**/tests/**/*.test.js",
            "**/__tests__/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "controllers/**/*.js",
            "services/**/*.js",
            "repositories/**/*.js",
            "middleware/**/*.js",
            "models/**/*.js",
            "validators/**/*.js",
            "utils/**/*.js"
        ],
        "coverageThreshold": {
            "global": {
                "lines": 65,
                "functions": 65,
                "branches": 40,
                "statements": 65
            }
        },
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ]
    }
}
