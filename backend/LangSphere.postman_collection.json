{
    "info": {
        "_postman_id": "langsphere-enterprise-v3",
        "name": "LangSphere — Complete Enterprise API (Phase 1, 2 & 3)",
        "description": "Full Postman Collection for LangSphere Enterprise API including Health, Auth, Lessons, Stories, Progress, Quiz, Shop, Gamification, Handwriting, OCR, Analytics, and User Management.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:5001", "type": "string" },
        { "key": "authToken", "value": "", "type": "string" },
        { "key": "testEmail", "value": "demo_user@example.com", "type": "string" },
        { "key": "testPassword", "value": "Password123!", "type": "string" }
    ],
    "item": [
        {
            "name": "🏥 System",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
                    }
                }
            ]
        },
        {
            "name": "🔐 Authentication",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"enterprisetest\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"gender\": \"other\",\n  \"mode\": \"student\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
                    }
                },
                {
                    "name": "Login User",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
                    }
                },
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"] }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
                    }
                }
            ]
        },
        {
            "name": "📚 Lessons",
            "item": [
                {
                    "name": "Get All Lessons (Paginated, Search, Filter)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/lessons?page=1&limit=10&language=tamil", "host": ["{{baseUrl}}"], "path": ["api", "lessons"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "language", "value": "tamil" }] }
                    }
                },
                {
                    "name": "Get Lessons by Language",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/lessons/tamil", "host": ["{{baseUrl}}"], "path": ["api", "lessons", "tamil"] }
                    }
                },
                {
                    "name": "Create Lesson",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{authToken}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"language\": \"tamil\",\n  \"level\": \"alphabets\",\n  \"title\": \"Enterprise Lesson Test\",\n  \"description\": \"Test lesson description\",\n  \"xpReward\": 50,\n  \"diamondReward\": 10\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/api/lessons", "host": ["{{baseUrl}}"], "path": ["api", "lessons"] }
                    }
                }
            ]
        },
        {
            "name": "📖 Stories",
            "item": [
                {
                    "name": "Get Stories by Language",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/stories/tamil", "host": ["{{baseUrl}}"], "path": ["api", "stories", "tamil"] }
                    }
                }
            ]
        },
        {
            "name": "📈 Progress",
            "item": [
                {
                    "name": "Get Progress for Language",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/progress/tamil", "host": ["{{baseUrl}}"], "path": ["api", "progress", "tamil"] }
                    }
                }
            ]
        },
        {
            "name": "🛍️ Shop & Gamification",
            "item": [
                {
                    "name": "Get Shop Catalog",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/shop/catalog", "host": ["{{baseUrl}}"], "path": ["api", "shop", "catalog"] }
                    }
                },
                {
                    "name": "Get Leaderboard",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/gamification/leaderboard", "host": ["{{baseUrl}}"], "path": ["api", "gamification", "leaderboard"] }
                    }
                }
            ]
        },
        {
            "name": "📊 Analytics",
            "item": [
                {
                    "name": "Get Dashboard Analytics",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
                        "url": { "raw": "{{baseUrl}}/api/analytics/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "dashboard"] }
                    }
                }
            ]
        }
    ]
}
